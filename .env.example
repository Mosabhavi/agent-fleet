# ---- Telegram bot tokens (one per agent, from @BotFather) ----
TONY_BOT_TOKEN=
BERLIN_BOT_TOKEN=
WARDEN_BOT_TOKEN=
BOB_BOT_TOKEN=

# ---- The group ----
# Run `python3 -m fleet whereami` after adding Tony to the group to fill these in.
FLEET_CHAT_ID=
FLEET_OWNER_ID=
FLEET_OWNER_NAME=Mosab

# ---- Model ----
ANTHROPIC_API_KEY=
# Leave FLEET_MODEL blank to auto-select the newest Sonnet at startup.
FLEET_MODEL=

# ---- Optional ----
FLEET_TZ=Asia/Riyadh
FLEET_LOG_LEVEL=INFO
FLEET_AUDIT=1
FLEET_TRANSCRIPT_WINDOW=40
FLEET_HOLD_LIST=            # tickers Warden must never propose exiting, e.g. ABC,XYZ
# BRAVE_API_KEY=            # enables the `search` tool; without it agents use RSS only

# ---- Bob, on the MacBook only ----
BOB_ROOTS=~/Downloads,~/Documents,~/Desktop
BOB_REVIEW_DIR=Review — Bob
BOB_MIN_AGE_MIN=10
BOB_DRY_RUN=0
BOB_SEALED=_sealed          # comma-separated folder names Bob never enters
